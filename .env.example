# Адрес сайта без слеша в конце. Из него собираются ссылки для шеринга и превью в соцсетях.
# Если не задан, берётся из заголовков запроса.
SITE_URL=

# Supabase основного Projectyard, обязательно. Ключ service_role используется только на сервере.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — невидимая проверка на бота перед похоронами. Без ключей выключена.
# Публичный ключ вшивается в сборку, после изменения нужен Redeploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Fine-grained personal access token: Public repositories (read-only), без прав.
# Без него GitHub даёт 60 запросов в час на IP, с ним — 5000. На проде нужен.
GITHUB_TOKEN=

# Подтверждение сайта в Google Search Console и Яндекс Вебмастере: только значение content из HTML-тега.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
