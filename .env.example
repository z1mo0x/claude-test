# Адрес сайта без слеша в конце. Из него собираются ссылки для шеринга и превью в соцсетях.
# Если не задан, берётся из заголовков запроса.
SITE_URL=

# Supabase основного Projectyard. Ключ service_role используется только на сервере.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Необязательно. Без токена GitHub даёт 60 запросов в час на IP, с токеном — 5000.
GITHUB_TOKEN=

# Только для локальной разработки без Supabase: путь к JSON-файлу с могилами.
# В режиме `next dev` по умолчанию используется .data/graves.json.
GRAVES_FILE=
