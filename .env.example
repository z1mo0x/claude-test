# Адрес сайта без слеша в конце. Из него собираются ссылки для шеринга и превью в соцсетях.
# Если не задан, берётся из заголовков запроса.
SITE_URL=

# Supabase основного Projectyard, обязательно. Ключ service_role используется только на сервере.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — невидимая проверка на бота перед похоронами. Без ключей выключена.
# Публичный ключ вшивается в сборку, после изменения нужен Redeploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Fine-grained personal access token: Public repositories (read-only), без прав.
# Без него GitHub даёт 60 запросов в час на IP, с ним — 5000. На проде нужен.
GITHUB_TOKEN=

# Подтверждение сайта в Google Search Console и Яндекс Вебмастере: только значение content из HTML-тега.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ── Telegram-бот (src/bot) ──────────────────────────────────────────────────
# Токен от @BotFather. Без него бот выключен. Никому не показывать и в чат не писать.
TELEGRAM_BOT_TOKEN=
# Длинная случайная строка (32+ символа): Telegram присылает её в заголовке каждого запроса на /api/telegram.
TELEGRAM_WEBHOOK_SECRET=
# Ещё одна случайная строка: с ней GitHub Actions дёргает /api/cron/posts. Тот же CRON_SECRET положить в секреты репозитория.
CRON_SECRET=
# Числовой Telegram id владельца: бот отвечает только ему. Узнать: написать боту /whoami.
OWNER_TELEGRAM_ID=
# Ник владельца на GitHub: по нему в базе находятся «мои» могилы для текстов постов.
OWNER_GITHUB_LOGIN=
# Канал для публикаций: @username или -100… (бот должен быть админом канала). Без него посты «в канал» придут вам предпросмотром.
TELEGRAM_CHANNEL_ID=
# Необязательно: ссылка на Vercel Analytics проекта, кнопка под «Метриками» в боте.
ANALYTICS_URL=
# Яндекс.Метрика: OAuth-токен с правом metrika:read, по нему бот показывает посетителей и источники. Номер счётчика (не секрет) лежит в src/lib/config.ts.
YANDEX_METRIKA_TOKEN=
# Необязательно: другой номер счётчика или пустая строка, чтобы отключить Метрику (например, на превью).
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# День 0 календаря продвижения, ГГГГ-ММ-ДД по Москве. Пока не задан, бот ничего не отправляет.
PROMO_START_DATE=
# 1 — в канал не публиковать, а присылать предпросмотр владельцу. Для проверки.
BOT_DRY_RUN=
